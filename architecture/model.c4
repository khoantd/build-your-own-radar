specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system
  element container
  tag external
}

model {
  user = actor 'User' {
    metadata {
      owner 'radar-team'
    }
  }

  radarApp = system 'ThoughtWorks Radar' {
    metadata {
      owner 'radar-team'
    }
    web = container 'Web UI' {
      technology 'React'
      metadata {
        owner 'radar-team'
      }
    }
    ingest = container 'Data Ingestion Service' {
      technology 'Node.js'
      metadata {
        owner 'radar-team'
      }
    }
  }

  googleSheets = system 'Google Sheets' {
    metadata {
      owner 'google'
    }
  }

  user -> radarApp.web 'uses'
  radarApp.web -> radarApp.ingest 'fetches data'
  radarApp.ingest -> googleSheets 'reads data from'
}

views {
  view index {
    title 'ThoughtWorks Radar Architecture'
    include *
    autoLayout LeftRight
  }

  view radarContext of radarApp {
    title 'Radar Application Context'
    include *
    autoLayout LeftRight
  }

  dynamic view dataFlow {
    title 'Data Flow from User to Google Sheets'
    user -> radarApp.web 'opens UI'
    radarApp.web -> radarApp.ingest 'requests data'
    radarApp.ingest -> googleSheets 'reads sheet'
  }
}
