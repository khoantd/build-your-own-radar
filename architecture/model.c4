specification {
  element actor { style { shape person; color amber } }
  element system
  element container
  element component
  element external { style { shape queue; icon tech:sheets } }
  tag external
  element link
}

model {
  user = actor 'User' {
    metadata { owner 'frontend-team' }
  }

  radarApp = system 'ThoughtWorks Radar' {
    webApp = container 'Web App' {
      metadata { owner 'frontend-team' }
      ui = component 'User Interface' {
        metadata { owner 'frontend-team' }
      }
      dataFetcher = component 'Data Fetcher' {
        metadata { owner 'backend-team' }
      }
    }
  }

  googleSheets = external 'Google Sheets' { #external
    metadata { owner 'google' }
    link https://docs.google.com/spreadsheets/d/your-sheet-id 'Public Radar Data Sheet'
  }

  user -> webApp 'opens radar page'
  dataFetcher -> googleSheets 'fetches data via Sheets API'
  webApp -> user 'renders radar'
}

views {
  view index {
    title 'Project Landscape'
    include *
    autoLayout RightLeft
  }

  view system radarApp {
    title 'ThoughtWorks Radar System'
    include *
    include -> dataFetcher
    include -> googleSheets
  }

  dynamic view dataPipeline {
    title 'Data Flow from Google Sheets to Radar'
    user -> webApp 'opens radar page'
    dataFetcher -> googleSheets 'calls Sheets API'
    googleSheets -> dataFetcher 'returns data'
    webApp -> user 'renders radar'
  }
}
