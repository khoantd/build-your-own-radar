specification {
  element actor { style { shape person; color amber } }
  element system
  element container
  element component
}

model {
  user = actor 'User' 'End user'
  googleSheets = system 'Google Sheets' { #external }

  radar = system 'ThoughtWorks Radar' {
    frontend = container 'Frontend' {
      technology 'React'
    }
    backend = container 'Backend Service' {
      technology 'Node.js'
      googleSheetsReader = component 'Google Sheets Reader' {
        technology 'Google APIs'
      }
    }
  }

  user -> frontend 'uses'
  frontend -> backend 'API calls'
  radar.backend.googleSheetsReader -> googleSheets 'reads data'
  radar.backend -> radar.frontend 'sends radar'
}

views {
  view index {
    title 'Landscape'
    include *
    autoLayout LeftRight
  }

  view radarContext of radar {
    title 'ThoughtWorks Radar – Context'
    include *
    include -> googleSheets
  }

  dynamic view sheetDataFlow {
    title 'Google Sheets Data Flow'
    radar.backend.googleSheetsReader -> googleSheets 'reads data'
    radar.backend -> radar.frontend 'sends radar'
  }
}
