// file: model.c4
// Purpose: Model cho ThoughtWorks Radar
// Owner: ThoughtWorks Team

specification {
  element actor { style { shape person; color amber } }
  element system { }
  element service { }
  element db { style { shape storage; icon tech:google-sheets } }

  tag external
}

model {
  radar = system 'ThoughtWorks Radar' {
    dataSource = service 'Google Sheets Data Source' {
      description 'Primary data source for radar generation.'
      technology 'Google Sheets'
    }
    management = service 'Data Management' {
      description 'Handles data processing and access.'
      technology 'Serverless'
    }
  }

  googleSheets = system 'Google Sheets' { #external }

  // Relationships
  radar -> googleSheets 'pulls data from'
  radar.management -> radar.dataSource 'processes'
}

views {
  view index {
    title 'ThoughtWorks Radar Architecture'
    include *
    autoLayout LeftRight
  }

  dynamic view dataFlow {
    title 'Data Flow in ThoughtWorks Radar'
    radar.dataSource -> googleSheets 'uses'
    googleSheets -> radar.management 'provides data'
  }
}
