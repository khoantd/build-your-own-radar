// file: model.c4
// Purpose: Model cho ThoughtWorks Radar project
// Owner: ThoughtWorks Team

specification {
  element actor { style { shape person; color amber } }
  element system
  element service
  element db { style { shape storage; icon tech:google-sheets } }
  element queue { style { shape queue } }
  
  tag external
}

model {
  radarApp = system 'ThoughtWorks Radar' {
    dataService = service 'Data Input Service' {
      technology 'Google Sheets'
    }
  }
  
  googleSheets = db 'Google Sheets' { #external }

  // Relationships
  radarApp -> googleSheets 'uses for input data'
}

views {
  view index {
    title 'System Overview'
    include *
    autoLayout LeftRight
  }

  dynamic view userOnboarding {
    title 'User Onboarding Flow'
    user -> radarApp 'accesses Radar'
    radarApp -> googleSheets 'retrieves data from'
  }
}
